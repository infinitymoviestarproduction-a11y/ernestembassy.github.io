        {"id": 1, "text": "Simplify: 2 + 3 × 4", "options": ["A. 20", "B. 14", "C. 24", "D. 10"], "correct": "B. 14", "explanation": "Multiply first: 3 × 4 = 12, then add 2 → 14", "stage": 1},
        {"id": 2, "text": "What is the value of 5²?", "options": ["A. 10", "B. 20", "C. 25", "D. 15"], "correct": "C. 25", "explanation": "5² means 5 × 5 = 25", "stage": 1},
        {"id": 3, "text": "Solve: 2x = 10", "options": ["A. 2", "B. 3", "C. 5", "D. 8"], "correct": "C. 5", "explanation": "Divide both sides by 2 → x = 5", "stage": 1},
        {"id": 4, "text": "What is ½ + ½?", "options": ["A. 1", "B. 2", "C. 3", "D. ¼"], "correct": "A. 1", "explanation": "½ + ½ = 1 whole", "stage": 1},
        {"id": 5, "text": "Find the LCM of 4 and 6", "options": ["A. 12", "B. 24", "C. 18", "D. 6"], "correct": "A. 12", "explanation": "Multiples of 4: 4,8,12… Multiples of 6: 6,12…", "stage": 1},
        {"id": 6, "text": "Find the HCF of 12 and 18", "options": ["A. 3", "B. 6", "C. 9", "D. 12"], "correct": "B. 6", "explanation": "Highest common factor is 6", "stage": 2},
        {"id": 7, "text": "What is 10% of 200?", "options": ["A. 10", "B. 20", "C. 30", "D. 40"], "correct": "B. 20", "explanation": "10/100 × 200 = 20", "stage": 2},
        {"id": 8, "text": "Convert 0.5 to fraction", "options": ["A. 1/5", "B. 1/2", "C. 2/5", "D. 5/10"], "correct": "B. 1/2", "explanation": "0.5 = 1/2", "stage": 2},
        {"id": 9, "text": "Solve: x + 7 = 12", "options": ["A. 3", "B. 5", "C. 7", "D. 9"], "correct": "B. 5", "explanation": "x = 12 − 7 = 5", "stage": 2},
        {"id": 10, "text": "What is 3 × 3 × 3?", "options": ["A. 9", "B. 18", "C. 27", "D. 36"], "correct": "C. 27", "explanation": "3³ = 27", "stage": 2},
        {"id": 11, "text": "What is the square root of 16?", "options": ["A. 2", "B. 3", "C. 4", "D. 8"], "correct": "C. 4", "explanation": "4 × 4 = 16", "stage": 3},
        {"id": 12, "text": "Simplify: 6 ÷ 2(1+2)", "options": ["A. 1", "B. 3", "C. 9", "D. 6"], "correct": "C. 9", "explanation": "Bracket first: 1+2=3, then 6 ÷ 2 × 3 = 9", "stage": 3},
        {"id": 13, "text": "What is 1000 ÷ 10?", "options": ["A. 10", "B. 100", "C. 1000", "D. 1"], "correct": "B. 100", "explanation": "1000 divided by 10 = 100", "stage": 3},
        {"id": 14, "text": "Find perimeter of a square with side 5cm", "options": ["A. 10cm", "B. 15cm", "C. 20cm", "D. 25cm"], "correct": "C. 20cm", "explanation": "4 × 5 = 20cm", "stage": 3},
        {"id": 15, "text": "What is area of square side 4cm?", "options": ["A. 8", "B. 12", "C. 16", "D. 20"], "correct": "C. 16", "explanation": "4 × 4 = 16cm²", "stage": 3},
        {"id": 16, "text": "What is 1/4 of 100?", "options": ["A. 20", "B. 25", "C. 30", "D. 40"], "correct": "B. 25", "explanation": "100 ÷ 4 = 25", "stage": 4},
        {"id": 17, "text": "What is 50% of 100?", "options": ["A. 25", "B. 50", "C. 75", "D. 100"], "correct": "B. 50", "explanation": "Half of 100 is 50", "stage": 4},
