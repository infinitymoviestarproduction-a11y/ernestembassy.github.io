        {"id": 1, "text": "Which of the following is a noun?", "options": ["A. Quickly", "B. Beautiful", "C. Book", "D. Run"], "correct": "C. Book", "explanation": "A noun is a name of a person, place, or thing. 'Book' is a thing.", "stage": 1},
        {"id": 2, "text": "A verb is a word that shows:", "options": ["A. Name", "B. Action", "C. Place", "D. Time"], "correct": "B. Action", "explanation": "A verb shows action or state of being.", "stage": 1},
        {"id": 3, "text": "Which is an adjective?", "options": ["A. Run", "B. Happy", "C. Quickly", "D. House"], "correct": "B. Happy", "explanation": "An adjective describes a noun.", "stage": 1},
        {"id": 4, "text": "Choose the correct pronoun:", "options": ["A. She", "B. Book", "C. Table", "D. Fast"], "correct": "A. She", "explanation": "'She' is a pronoun used in place of a noun.", "stage": 1},
        {"id": 5, "text": "Identify the verb:", "options": ["A. Blue", "B. Jump", "C. Chair", "D. Beautiful"], "correct": "B. Jump", "explanation": "'Jump' is an action word.", "stage": 1},
        {"id": 6, "text": "Antonym of 'big' is:", "options": ["A. Large", "B. Small", "C. Huge", "D. Wide"], "correct": "B. Small", "explanation": "'Small' is the opposite of 'big'.", "stage": 2},
        {"id": 7, "text": "Synonym of 'happy' is:", "options": ["A. Sad", "B. Angry", "C. Joyful", "D. Tired"], "correct": "C. Joyful", "explanation": "'Joyful' means the same as 'happy'.", "stage": 2},
        {"id": 8, "text": "Which is a proper noun?", "options": ["A. Boy", "B. School", "C. Lagos", "D. City"], "correct": "C. Lagos", "explanation": "'Lagos' is a specific name of a place.", "stage": 2},
        {"id": 9, "text": "Choose the correct sentence:", "options": ["A. goes he school", "B. He goes to school", "C. School he goes", "D. To school goes he"], "correct": "B. He goes to school", "explanation": "Option B is grammatically correct.", "stage": 2},
        {"id": 10, "text": "A conjunction is used to:", "options": ["A. Name things", "B. Join words or sentences", "C. Describe verbs", "D. Show actions"], "correct": "B. Join words or sentences", "explanation": "Conjunctions join words or sentences.", "stage": 2},
        {"id": 11, "text": "Which is a vowel?", "options": ["A. B", "B. C", "C. A", "D. D"], "correct": "C. A", "explanation": "A, E, I, O, U are vowels.", "stage": 3},
        {"id": 12, "text": "The plural of child is:", "options": ["A. Childs", "B. Children", "C. Childes", "D. Childer"], "correct": "B. Children", "explanation": "Irregular plural form is 'children'.", "stage": 3},
        {"id": 13, "text": "Which is a sentence?", "options": ["A. Quickly run", "B. Beautiful house", "C. She sings well", "D. In the school"], "correct": "C. She sings well", "explanation": "Option C expresses a complete idea.", "stage": 3},
