        {"id": 15, "text": "Which is a collective noun?", "options": ["A. Book", "B. Team", "C. Chair", "D. Girl"], "correct": "B. Team", "explanation": "A team is a group noun.", "stage": 3},
        {"id": 16, "text": "The opposite of 'hot' is:", "options": ["A. Warm", "B. Cold", "C. Boiling", "D. Heat"], "correct": "B. Cold", "explanation": "Cold is the opposite of hot.", "stage": 4},
        {"id": 17, "text": "Choose correct spelling:", "options": ["A. Freind", "B. Friend", "C. Frend", "D. Freand"], "correct": "B. Friend", "explanation": "Correct spelling is 'friend'.", "stage": 4},
        {"id": 18, "text": "Capital letter is used:", "options": ["A. In middle of sentence", "B. At beginning of sentence", "C. At end only", "D. Never"], "correct": "B. At beginning of sentence", "explanation": "Sentences start with capital letters.", "stage": 4},
