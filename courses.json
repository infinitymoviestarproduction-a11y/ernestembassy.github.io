        {"id": 2, "text": "'Gaa' bụ ụdị okwu gịnị?", "options": ["A. Aha", "B. Okwu omume", "C. Nkowa", "D. Mgbakwunye"], "correct": "B. Okwu omume", "explanation": "'Gaa' na-egosi ime ihe (verb).", "stage": 1},
        {"id": 3, "text": "Kedu nke bụ aha ebe?", "options": ["A. Nwoke", "B. Ụlọ", "C. Na-agba ọsọ", "D. Mara mma"], "correct": "B. Ụlọ", "explanation": "Ụlọ bụ ebe mmadụ bi.", "stage": 1},
        {"id": 4, "text": "'Ọma' bụ:", "options": ["A. Aha", "B. Okwu omume", "C. Nkowa", "D. Mgbakwunye"], "correct": "C. Nkowa", "explanation": "Ọ na-akọwa ihe.", "stage": 1},
        {"id": 5, "text": "Kedu nke bụ okwu omume?", "options": ["A. Nri", "B. Gụọ", "C. Ụlọ", "D. Nwa"], "correct": "B. Gụọ", "explanation": "'Gụọ' na-egosi ime ihe.", "stage": 1},
        {"id": 6, "text": "'Mmadụ' pụtara:", "options": ["A. Animal", "B. Person", "C. House", "D. Food"], "correct": "B. Person", "explanation": "Mmadụ bụ human being.", "stage": 2},
        {"id": 7, "text": "Kedu nke bụ aha?", "options": ["A. Na-eje ije", "B. Akwụkwọ", "C. Mara mma", "D. Na-agba ọsọ"], "correct": "B. Akwụkwọ", "explanation": "Akwụkwọ bụ ihe.", "stage": 2},
        {"id": 8, "text": "'Ọ na-eri nri' bụ:", "options": ["A. Ajụjụ", "B. Okwu omume", "C. Nkowa", "D. Aha"], "correct": "B. Okwu omume", "explanation": "Ọ na-egosi omume.", "stage": 2},
        {"id": 9, "text": "'Ụmụaka' bụ:", "options": ["A. Singular", "B. Plural", "C. Verb", "D. Adjective"], "correct": "B. Plural", "explanation": "Ọ na-egosi ọtụtụ ụmụ.", "stage": 2},
        {"id": 10, "text": "'Ekele' pụtara:", "options": ["A. Fight", "B. Greeting", "C. Run", "D. Eat"], "correct": "B. Greeting", "explanation": "Ekele bụ greeting.", "stage": 2},
        {"id": 11, "text": "Kedu nke bụ nkowa?", "options": ["A. Mara mma", "B. Gaa", "C. Akwụkwọ", "D. Ụlọ"], "correct": "A. Mara mma", "explanation": "Ọ na-akọwa ihe.", "stage": 3},
        {"id": 12, "text": "'Abụ m nwa akwụkwọ' pụtara:", "options": ["A. I am a teacher", "B. I am a student", "C. I am a man", "D. I am a house"], "correct": "B. I am a student", "explanation": "Ọ na-egosi na mmadụ bụ student.", "stage": 3},
        {"id": 13, "text": "'Nne' bụ:", "options": ["A. Father", "B. Mother", "C. Child", "D. Teacher"], "correct": "B. Mother", "explanation": "Nne bụ mother.", "stage": 3},
        {"id": 14, "text": "'Nnọọ' bụ:", "options": ["A. Goodbye", "B. Welcome", "C. Run", "D. Eat"], "correct": "B. Welcome", "explanation": "Nnọọ pụtara welcome.", "stage": 3},
        {"id": 15, "text": "'Aga m ụlọ akwụkwọ' bụ:", "options": ["A. Past tense", "B. Future tense", "C. Present", "D. Question"], "correct": "B. Future tense", "explanation": "Ọ na-egosi ihe ga-eme n'ọdịnihu.", "stage": 3},
        {"id": 16, "text": "'Na-agba ọsọ' bụ:", "options": ["A. Noun", "B. Verb", "C. Adjective", "D. Place"], "correct": "B. Verb", "explanation": "Ọ na-egosi omume.", "stage": 4},
        {"id": 17, "text": "'Nwa' pụtara:", "options": ["A. Child", "B. Father", "C. Teacher", "D. House"], "correct": "A. Child", "explanation": "Nwa bụ child.", "stage": 4},
        {"id": 18, "text": "'Ụlọ akwụkwọ' bụ:", "options": ["A. Market", "B. School", "C. House", "D. Road"], "correct": "B. School", "explanation": "School is ụlọ akwụkwọ.", "stage": 4},
