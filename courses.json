        {"id": 1, "text": "What is a computer?", "options": ["A. A cooking machine", "B. An electronic device that processes data", "C. A washing machine", "D. A radio"], "correct": "B. An electronic device that processes data", "explanation": "A computer is an electronic device that accepts data, processes it, and produces meaningful information.", "stage": 1},
        {"id": 2, "text": "Which of the following is an input device?", "options": ["A. Monitor", "B. Printer", "C. Keyboard", "D. Speaker"], "correct": "C. Keyboard", "explanation": "A keyboard is used to enter data into the computer.", "stage": 1},
        {"id": 3, "text": "The brain of the computer is called:", "options": ["A. RAM", "B. CPU", "C. Hard disk", "D. Monitor"], "correct": "B. CPU", "explanation": "The CPU (Central Processing Unit) controls all operations of the computer.", "stage": 1},
        {"id": 4, "text": "Which of these is an output device?", "options": ["A. Mouse", "B. Keyboard", "C. Monitor", "D. Scanner"], "correct": "C. Monitor", "explanation": "A monitor displays information from the computer.", "stage": 1},
        {"id": 5, "text": "Data that has been processed is called:", "options": ["A. Raw data", "B. Information", "C. Input", "D. Output device"], "correct": "B. Information", "explanation": "Information is processed data that is meaningful.", "stage": 1},
        {"id": 6, "text": "Which of the following stores data permanently?", "options": ["A. RAM", "B. CPU", "C. Hard disk", "D. Cache"], "correct": "C. Hard disk", "explanation": "A hard disk stores data permanently even when the computer is off.", "stage": 2},
        {"id": 7, "text": "Which device is used to point and click?", "options": ["A. Keyboard", "B. Mouse", "C. Printer", "D. Monitor"], "correct": "B. Mouse", "explanation": "A mouse is used to move the pointer and select items on the screen.", "stage": 2},
        {"id": 8, "text": "Example of system software is:", "options": ["A. MS Word", "B. Windows", "C. Calculator", "D. Paint"], "correct": "B. Windows", "explanation": "Windows is an operating system that controls computer hardware.", "stage": 2},
        {"id": 9, "text": "Which of the following is application software?", "options": ["A. Windows", "B. Linux", "C. MS Excel", "D. BIOS"], "correct": "C. MS Excel", "explanation": "MS Excel is used for calculations and data analysis.", "stage": 2},
        {"id": 10, "text": "The full meaning of ICT is:", "options": ["A. Internet Computer Technology", "B. Information Communication Technology", "C. Internal Computer Transfer", "D. Intelligent Communication Tool"], "correct": "B. Information Communication Technology", "explanation": "ICT stands for Information and Communication Technology.", "stage": 2},
        {"id": 11, "text": "RAM stands for:", "options": ["A. Random Access Memory", "B. Read And Manage", "C. Run All Memory", "D. Ready Access Machine"], "correct": "A. Random Access Memory", "explanation": "RAM is temporary memory used while the computer is working.", "stage": 3},
        {"id": 12, "text": "Which device prints documents?", "options": ["A. Monitor", "B. Printer", "C. Speaker", "D. Scanner"], "correct": "B. Printer", "explanation": "A printer produces hard copy output.", "stage": 3},
        {"id": 13, "text": "Computer system consists of:", "options": ["A. Hardware only", "B. Software only", "C. Hardware and software", "D. Electricity only"], "correct": "C. Hardware and software", "explanation": "A computer system includes both hardware and software.", "stage": 3},
        {"id": 14, "text": "Which is NOT a computer part?", "options": ["A. CPU", "B. Monitor", "C. Keyboard", "D. Spoon"], "correct": "D. Spoon", "explanation": "A spoon is not related to computers.", "stage": 3},
        {"id": 15, "text": "Example of secondary storage:", "options": ["A. RAM", "B. ROM", "C. Hard disk", "D. CPU"], "correct": "C. Hard disk", "explanation": "Hard disk stores data permanently.", "stage": 3},
        {"id": 16, "text": "Which device is used to scan documents?", "options": ["A. Printer", "B. Scanner", "C. Keyboard", "D. Monitor"], "correct": "B. Scanner", "explanation": "A scanner converts paper documents into digital form.", "stage": 4},
        {"id": 17, "text": "Which is NOT software?", "options": ["A. Windows", "B. Linux", "C. Mouse", "D. MS Word"], "correct": "C. Mouse", "explanation": "Mouse is hardware, not software.", "stage": 4},
        {"id": 18, "text": "A computer without software is:", "options": ["A. Fully functional", "B. Useless", "C. Faster", "D. Wireless"], "correct": "B. Useless", "explanation": "Hardware cannot function without software.", "stage": 4},
        {"id": 19, "text": "Example of browser:", "options": ["A. Chrome", "B. Word", "C. Excel", "D. Paint"], "correct": "A. Chrome", "explanation": "Chrome is used to access the internet.", "stage": 4},
        {"id": 20, "text": "Which device stores memory temporarily?", "options": ["A. Hard disk", "B. RAM", "C. Monitor", "D. Printer"], "correct": "B. RAM", "explanation": "RAM stores data temporarily during processing.", "stage": 4}
